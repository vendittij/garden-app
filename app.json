{
  "expo": {
    "name": "Garden App",
    "slug": "garden-app",
    "version": "1.0.0",
    "scheme": "garden-app",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.garden.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.garden.app"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Garden App to photograph your plants to identify species and track growth."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Garden App to use your location to determine your USDA growing zone and local frost dates."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ]
  }
}
